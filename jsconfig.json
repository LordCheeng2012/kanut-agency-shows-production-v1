{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components": ["src/components/index.js"],
      "@components/*": ["src/components/*"],
      "@utils/*": ["src/utils/*"],
      "@absolute/*": ["src/*"],
      "@css/*": ["src/styles/*"],
      "@js/*": ["src/js/*"],
      "@pages/*": ["src/pages/*"],
      "@assets/*": ["src/assets/*"],
      "@html/*": ["html/*"],
      "@data/*": ["src/data/*"],
      "@imgs/*": ["src/assets/imgs"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
